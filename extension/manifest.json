{
  "manifest_version": 3,
  "name": "X Article Downloader",
  "version": "0.1.0",
  "key": "",
  "description": "One-click export of the current X Article to local Markdown, PDF, or DOCX.",
  "action": {
    "default_title": "X Article Downloader",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
